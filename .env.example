# Neon connection string (Dashboard -> Connect). Used by BOTH FastAPI and Drizzle.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

SECRET_KEY=generate-with-openssl-rand-hex-32

# The single admin, auto-created on first startup if none exists
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Central Admin

PAYMENT_PROVIDER=mock
CORS_ORIGINS=http://localhost:3000

# Cloudinary (Dashboard -> Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
